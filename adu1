<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>스마트 텃밭 일지</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .card {
            transition: transform 0.3s ease-in-out;
        }
        .card:hover {
            transform: translateY(-5px);
        }
        .hover-effect:hover {
            background-color: rgba(255, 255, 255, 0.2);
        }
    </style>
</head>
<body class="bg-green-50 font-sans">
    <div class="container mx-auto p-4 md:p-8">
        <header class="text-center mb-10">
            <h1 class="text-3xl md:text-5xl font-bold text-green-800">
                <i class="fas fa-seedling text-green-600 mr-2"></i>우리만의 스마트 텃밭
            </h1>
            <p class="text-md md:text-lg text-gray-600 mt-2">아두이노로 실시간 텃밭 상태를 확인해요!</p>
        </header>
        
        <main class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            
            <div class="card bg-white rounded-xl shadow-lg p-6 flex items-center space-x-4">
                <div class="bg-red-100 text-red-500 p-3 rounded-full">
                    <i class="fas fa-temperature-half text-2xl"></i>
                </div>
                <div>
                    <h3 class="text-xl font-semibold text-gray-700">현재 온도</h3>
                    <p id="temperature" class="text-4xl font-bold text-gray-900 mt-1">25°C</p>
                </div>
            </div>

            <div class="card bg-white rounded-xl shadow-lg p-6 flex items-center space-x-4">
                <div class="bg-blue-100 text-blue-500 p-3 rounded-full">
                    <i class="fas fa-tint text-2xl"></i>
                </div>
                <div>
                    <h3 class="text-xl font-semibold text-gray-700">현재 습도</h3>
                    <p id="humidity" class="text-4xl font-bold text-gray-900 mt-1">60%</p>
                </div>
            </div>

            <div class="card bg-white rounded-xl shadow-lg p-6 flex flex-col justify-center items-center text-center">
                <div class="bg-yellow-100 text-yellow-500 p-3 rounded-full mb-3">
                    <i class="fas fa-droplet text-2xl"></i>
                </div>
                <h3 class="text-xl font-semibold text-gray-700 mb-2">오늘의 기록</h3>
                <button id="record-btn" class="hover-effect bg-green-500 text-white font-bold py-2 px-6 rounded-full transition duration-300">
                    <i class="fas fa-check-circle mr-2"></i>기록하기
                </button>
            </div>
            
        </main>
        
        <div class="mt-10 p-6 bg-green-700 rounded-xl shadow-lg text-white text-center">
            <h2 class="text-2xl font-bold">궁금한 점이 있다면 언제든지 물어보세요!</h2>
            <p class="mt-2 text-sm md:text-base">우리 함께 멋진 텃밭 앱을 완성해봐요!</p>
        </div>
    </div>
    
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const recordBtn = document.getElementById('record-btn');
            
            // '기록하기' 버튼 클릭 이벤트 리스너 추가
            recordBtn.addEventListener('click', () => {
                const temperature = document.getElementById('temperature').textContent;
                const humidity = document.getElementById('humidity').textContent;
                
                // 1. 현재 기록 데이터를 객체로 만듭니다.
                const record = {
                    date: new Date().toLocaleDateString(),
                    time: new Date().toLocaleTimeString(),
                    temperature: temperature,
                    humidity: humidity
                };
                
                // 2. localStorage에 기존 기록이 있는지 확인하고 가져옵니다.
                const existingRecords = JSON.parse(localStorage.getItem('garden_records')) || [];

                // 3. 새로운 기록을 기존 기록 배열에 추가합니다.
                existingRecords.push(record);
                
                // 4. 업데이트된 기록 배열을 다시 문자열로 변환하여 localStorage에 저장합니다.
                localStorage.setItem('garden_records', JSON.stringify(existingRecords));
                
                // 사용자에게 알림 메시지 표시
                alert(`✅ 텃밭 기록 완료!\n온도: ${temperature}\n습도: ${humidity}`);
                
                console.log('--- 모든 기록 ---');
                console.log(existingRecords); // 저장된 전체 기록 확인
            });
        });
    </script>
</body>
</html>
